{
  "name": "glint-learning-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:pages": "npm run build && npm --prefix admin-platform run check && npm --prefix admin-platform run build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:pages": "node tests/pages.mjs",
    "test:resilience": "node tests/resilience.mjs",
    "check": "tsc --noEmit",
    "media": "python scripts/make_media.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "overrides": {"rollup":"$rollup"},
  "devDependencies": {
    "rollup":"npm:@rollup/wasm-node@4.64.4",
    "esbuild": "^0.28.2",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "tsx": "^4.20.0"
  }
}
